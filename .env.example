# Base de datos MySQL
DATABASE_URL="mysql://app_user:app_password@localhost:3306/audio_to_text"

# Redis (Colas BullMQ y SSE Pub/Sub)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# API Server
PORT=4000
NODE_ENV="development"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Seguridad y Autenticación
JWT_ACCESS_SECRET="change-this-super-secret-access-token-key-min-32-chars-long"
JWT_REFRESH_SECRET="change-this-super-secret-refresh-token-key-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# reCAPTCHA v3
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY="dummy-secret-key-for-dev"
RECAPTCHA_MIN_SCORE=0.5

# Almacenamiento local o S3
STORAGE_DRIVER="local" # local | s3
STORAGE_LOCAL_PATH="./storage"
S3_BUCKET_NAME="audio-transcription-bucket"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# Límites de subida y procesamiento
MAX_UPLOAD_MB=200
AUDIO_RETENTION_HOURS=48

# Motor de transcripción (whisper-cpp | whisper-api)
TRANSCRIPTION_ENGINE="whisper-cpp"
WHISPER_CPP_PATH="/usr/local/bin/whisper-cli"
WHISPER_MODEL_PATH="./models/ggml-base.bin"
OPENAI_API_KEY=""

# OAuth Google (opcional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"
