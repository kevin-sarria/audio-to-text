// Prisma Schema para audio-to-text (transcripción + diarización)
// Compatible con MySQL 8.0 y Clean Architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Proveedores de autenticación soportados en la plataforma
enum AuthProvider {
  LOCAL
  GOOGLE
}

/// Estados posibles de la cuenta de usuario
enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

/// Estados del ciclo de vida del procesamiento de una sesión de transcripción
enum SessionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Modelo de Usuario principal del sistema
/// Representa credenciales y estado de autenticación (3FN)
model User {
  id           String       @id @default(uuid()) @db.Char(36)
  email        String       @unique @db.VarChar(255)
  passwordHash String?      @map("password_hash") @db.VarChar(255)
  authProvider AuthProvider @default(LOCAL) @map("auth_provider")
  googleSub    String?      @unique @map("google_sub") @db.VarChar(64)
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  profile       UserProfile?
  sessions      TranscriptionSession[]
  projectFolders ProjectFolder[]
  refreshTokens RefreshToken[]

  @@index([status])
  @@map("users")
}

/// Perfil de usuario desacoplado de las credenciales de acceso (3FN)
model UserProfile {
  id          String  @id @default(uuid()) @db.Char(36)
  userId      String  @unique @map("user_id") @db.Char(36)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String? @map("full_name") @db.VarChar(150)
  avatarUrl   String? @map("avatar_url") @db.VarChar(512)
  preferences Json?

  @@map("user_profiles")
}

/// Tokens de refresco rotativos con detección de reuso mediante familyId
/// Almacena exclusivamente el hash SHA-256 del token por motivos de seguridad
model RefreshToken {
  id           String         @id @default(uuid()) @db.Char(36)
  userId       String         @map("user_id") @db.Char(36)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String         @unique @map("token_hash") @db.Char(64)
  familyId     String         @map("family_id") @db.Char(36)
  expiresAt    DateTime       @map("expires_at") @db.DateTime(3)
  revokedAt    DateTime?      @map("revoked_at") @db.DateTime(3)
  replacedById String?        @map("replaced_by_id") @db.Char(36)
  replacedBy   RefreshToken?  @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  successors   RefreshToken[] @relation("TokenRotation")
  createdAt    DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Sesión de transcripción y metadatos del archivo de audio subido
/// Nota técnica: audioExpiresAt es calculado en la capa de aplicación como now + 48h
/// debido a que MySQL no soporta default de expresiones temporales vía Prisma.
model TranscriptionSession {
  id               String        @id @default(uuid()) @db.Char(36)
  userId           String?       @map("user_id") @db.Char(36)
  user             User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestTokenHash   String?       @unique @map("guest_token_hash") @db.Char(64)
  originalFileName String        @map("original_file_name") @db.VarChar(255)
  fileFormat       String        @map("file_format") @db.VarChar(16)
  durationSeconds  Decimal?      @map("duration_seconds") @db.Decimal(10, 3)
  fileSizeBytes    BigInt        @map("file_size_bytes")
  storagePath      String?       @map("storage_path") @db.VarChar(512)
  audioExpiresAt   DateTime      @map("audio_expires_at") @db.DateTime(3)
  isAudioPurged    Boolean       @default(false) @map("is_audio_purged")
  status           SessionStatus @default(PENDING)
  sourceLanguage   String?       @map("source_language") @db.VarChar(10)
  errorMessage     String?       @map("error_message") @db.VarChar(500)
  projectFolderId  String?       @map("project_folder_id") @db.Char(36)
  projectFolder    ProjectFolder? @relation(fields: [projectFolderId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  speakers        Speaker[]
  segments        TranscriptionSegment[]
  translations    Translation[]
  meetingAnalysis MeetingAnalysis?

  @@index([userId])
  @@index([status])
  @@index([projectFolderId])
  @@index([audioExpiresAt, isAudioPurged])
  @@index([userId, createdAt])
  @@map("transcription_sessions")
}

/// Hablante identificado en una sesión de diarización
/// Permite asignar un nombre personalizado manteniendo la etiqueta original
model Speaker {
  id         String               @id @default(uuid()) @db.Char(36)
  sessionId  String               @map("session_id") @db.Char(36)
  session    TranscriptionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  label      String               @db.VarChar(50)
  customName String?              @map("custom_name") @db.VarChar(100)

  segments TranscriptionSegment[]

  @@unique([sessionId, label])
  @@unique([id, sessionId])
  @@index([sessionId])
  @@map("speakers")
}

/// Segmento de texto transcrito asociado a un intervalo temporal y un hablante
/// Restricciones en SQL manual: CHECK (end_time_ms > start_time_ms) y CHECK (start_time_ms >= 0)
model TranscriptionSegment {
  id              String               @id @default(uuid()) @db.Char(36)
  sessionId       String               @map("session_id") @db.Char(36)
  session         TranscriptionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speakerId       String               @map("speaker_id") @db.Char(36)
  speaker         Speaker              @relation(fields: [speakerId], references: [id], onDelete: Restrict)
  startTimeMs     Int                  @map("start_time_ms")
  endTimeMs       Int                  @map("end_time_ms")
  content         String               @db.Text
  confidenceScore Decimal?             @map("confidence_score") @db.Decimal(4, 3)

  @@index([sessionId, startTimeMs])
  @@index([speakerId])
  @@map("transcription_segments")
}

/// Traducción completa o por fragmento generada para una sesión
model Translation {
  id             String               @id @default(uuid()) @db.Char(36)
  sessionId      String               @map("session_id") @db.Char(36)
  session        TranscriptionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  targetLanguage String               @map("target_language") @db.VarChar(10)
  translatedText String               @map("translated_text") @db.LongText
  createdAt      DateTime             @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([sessionId, targetLanguage])
  @@index([sessionId])
  @@map("translations")
}

/// Resumen técnico e issues para agentes de IA generados para una reunión
model MeetingAnalysis {
  id              String               @id @default(uuid()) @db.Char(36)
  sessionId       String               @unique @map("session_id") @db.Char(36)
  session         TranscriptionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title           String?              @db.VarChar(150)
  projectContext  String?              @map("project_context") @db.Text
  summary         String               @db.MediumText
  keyDecisions    Json                 @map("key_decisions")
  topicsDiscussed Json                 @map("topics_discussed")
  issues          Json                 @db.Json
  createdAt       DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([sessionId])
  @@map("meeting_analyses")
}

/// Carpetas de Proyecto (harnesses de contexto técnico para agentes de IA)
model ProjectFolder {
  id               String                 @id @default(uuid()) @db.Char(36)
  userId           String?                @map("user_id") @db.Char(36)
  user             User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String                 @db.VarChar(120)
  description      String?                @db.VarChar(500)
  technicalContext String                 @map("technical_context") @db.Text
  defaultProvider  String?                @map("default_provider") @db.VarChar(50)
  defaultModel     String?                @map("default_model") @db.VarChar(100)
  customApiKey     String?                @map("custom_api_key") @db.VarChar(256)
  createdAt        DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.DateTime(3)

  sessions         TranscriptionSession[]

  @@index([userId])
  @@map("project_folders")
}


