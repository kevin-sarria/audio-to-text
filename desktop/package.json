{
  "name": "@audio-to-text/desktop",
  "version": "1.0.1",
  "type": "module",
  "main": "dist/main.cjs",
  "description": "Aplicación de escritorio instalable de Audio-to-Text",
  "author": "Audio-to-Text Team <team@audio2text.local>",
  "scripts": {
    "build": "node scripts/build-main.mjs",
    "build:main": "node scripts/build-main.mjs",
    "fetch:binaries": "node scripts/fetch-binaries.mjs",
    "dev": "node scripts/build-main.mjs && electron .",
    "predist": "npm run build -w @audio-to-text/shared && npm run build -w @audio-to-text/web && node scripts/build-main.mjs",
    "predist:win": "npm run predist",
    "predist:linux": "npm run predist",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist": "electron-builder"
  },
  "dependencies": {
    "pdfkit": "^0.15.0",
    "fontkit": "^2.0.4",
    "png-js": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "electron": "45.2.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.23.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "typescript": "^5.5.4"
  }
}
